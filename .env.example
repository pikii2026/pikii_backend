# =====================================================
# Pickii 환경변수 템플릿
# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 Git에 커밋하지 않습니다. (.gitignore 처리됨)
# =====================================================

# --- Docker (docker compose 가 자동으로 읽음) ---
# 로컬 MySQL root 비밀번호 (미설정 시 compose 기본값: pickii1234)
MYSQL_ROOT_PASSWORD=pickii1234

# --- Spring Boot (IntelliJ 실행 구성의 환경변수에 등록) ---
# JWT 서명 시크릿 (팀 공용 값을 노션/디스코드 등으로 공유받아 입력)
JWT_SECRET=

# 인증코드 발송용 Gmail 계정 (앱 비밀번호 사용, 계정 설정에서 발급)
MAIL_USERNAME=
MAIL_PASSWORD=
